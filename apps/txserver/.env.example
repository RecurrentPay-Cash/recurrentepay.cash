# RecurrentPay.Cash txserver — environment (placeholders only; NEVER commit real secrets)

# Postgres connection string (required)
DATABASE_URL=postgres://recurrentpay:recurrentpay@localhost:5432/recurrentpay

# Electrum/Fulcrum server (chipnet by default; raw TCP JSON-RPC)
ELECTRUM_URL=tcp://chipnet.imaginary.cash:50001

# Chain-watcher implementation: electrum (default) or mock (tests / local dev without a node)
CHAIN_WATCHER=electrum

# Platform service pkh (hex) — the presence input for authorized txs
SERVICE_PKH=0000000000000000000000000000000000000000

# Platform service private key (hex) — env only, never committed
SERVICE_KEY=

# General Protocols oracle relay REST base URL (BCH subs); client appends /oracleMessages
ORACLE_URL=https://oracles.generalprotocols.com/api/v1

# Top-up warning buffer as a fraction (1.05 = 105%)
BUFFER_PERCENT=1.05

# Mutual-consent proposal expiry window, in seconds (default 24h)
PROPOSAL_EXPIRY_SECONDS=86400

# HTTP port
PORT=3001

# CORS allow-list for the browser (comma-separated origins). Empty = deny all
# cross-origin requests (production should set this explicitly). Unset = dev
# default (http://localhost:3000).
CORS_ORIGINS=http://localhost:3000

# Scheduler interval loop (off by default; set true in production)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MS=60000
