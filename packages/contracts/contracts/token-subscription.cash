pragma cashscript ^0.14.0;

// =============================================================================
// RecurrentPay.Cash — token-subscription.cash
//
// Sources of truth (SDD):
//   openspec/changes/recurrent-pay-mvp/design.md
//       § Contract State Model
//       § Functions — gate → settle → delta
//       § Settlement semantics (m-period catch-up)
//       § Arrears, pause and reactivation
//       § Security Notes
//   openspec/changes/recurrent-pay-mvp/specs/subscription-contract/spec.md
//
// -----------------------------------------------------------------------------
// MODEL (Nov 16–17 revision)
//
// A token subscription is a covenant made of TWO UTXOs, both locked by this same
// contract (same constructor args):
//
//   * state UTXO — one MUTABLE NFT of `stateCategory`; its commitment carries the
//                  whole subscription state (121 bytes, layout below).
//   * escrow UTXO — fungible tokens of `fundsCategory` (the subscription asset).
//
// The escrow is identified by CO-CREATION: it is the funds-category input whose
// `outpointTransactionHash` equals the state NFT input's (they were created in the
// same genesis transaction). This stops a stray funds UTXO (different txid) from
// posing as escrow. The settlement balance is the ESCROW ONLY, never `totalIn`.
//
// The covenant always holds at least ONE unit — the SEED — supplied by the
// supporter at creation (`amount + seed`), retained for the sub's life, refunded
// at `cancel`. `spendable = escrow − SEED`. This makes co-creation unconditional:
// a 0-unit token output is not a token UTXO, so without the seed "the escrow
// exists" would have an empty-escrow hole.
//
// -----------------------------------------------------------------------------
// COMMITMENT LAYOUT — 121 bytes (network limit: 128)
//
//   0..20    supporterPkh    bytes20
//   20..40   supporteePkh    bytes20
//   40..60   servicePkh      bytes20
//   60..68   amount          int, 8 B LE — token base units
//   68..76   amountNext      int, 8 B LE
//   76..80   period          int, 4 B LE — seconds
//   80..84   periodNext      int, 4 B LE
//   84..88   lastPeriodTime  int, 4 B LE — unix seconds
//   88..89   mode            int, 1 B    — 0 = A (pay-then-use), 1 = B (lock-then-use)
//   89..121  fundsCategory   bytes32
//
// `amount`/`period` are the rate of the period that just ended; `amountNext`/
// `periodNext` are the rate for the upcoming period. "Always-replace": `pull`
// and `reactivate` promote them unconditionally, no sentinel, no branch.
//
// Epoch note: `lastPeriodTime` is stored in 4 bytes, so OP_NUM2BIN caps it at
// 2^31 − 1 (2038-01-19). Ample for the MVP; flagged for the v2 commitment layout.
//
// -----------------------------------------------------------------------------
// OUTPUT LAYOUT — fixed indices, `m = 0` shifts later outputs down
//
//   pull:      0 supportee (gross − fee), 1 service (fee), 2 state, 3 funds (escrow − gross)
//   cancel:    [0 supportee, 1 service] if gross > 0, then refund (totalIn − gross), burn NFT
//   modify:    0 state, 1 funds (totalIn)
//   setPkh:    0 state, 1 funds (totalIn)
//   fund:      0 state, 1 funds (totalIn)
//   withdraw:  [0 supportee, 1 service] if gross > 0, then state, funds(retained), payout
//   reactivate:[0 supportee] if supporteeAmount > 0, [service] if fee > 0, state, funds
//   migrate:   [0 supportee, 1 service] if gross > 0, state, funds(new), old remainder
//
// Any further output (BCH change, typically) is allowed but must carry no token,
// except a foreign-category token routed to the supporter (see `tailOk`).
//
// -----------------------------------------------------------------------------
// AUTHORISATION — `presence-always`, no signatures
//
// An action is authorised by an input that spends the actor's address — P2PKH
// **or** P2SH20 of the actor's hash. Standard wallets sign their own inputs, so
// no `checkSig` and no public-key reveal are needed, and multisig/DAO actors
// work for free (design.md § Architecture Decisions).
//
// TIME — CashScript's `tx.time` may only appear inside `require(tx.time >= …)`;
// the readable form is `tx.locktime`, used by the arithmetic below. Transactions
// must carry the current unix time in nLocktime; the compiler injects the
// non-final-sequence guard that makes that binding effective.
// =============================================================================

int constant COMMITMENT_SIZE = 121;
bytes constant MUTABLE_NFT = 0x01;

// The 1-unit seed: always retained so the escrow UTXO always exists.
int constant SEED = 1;
// Service fee: a percent (divisor /100), charged per period paid.
int constant SERVICE_FEE_PERCENT = 1;
// Token floor: at least this many base units per period paid.
int constant MIN_FEE_PER_PERIOD = 1;

// -----------------------------------------------------------------------------
// Commitment codec
// -----------------------------------------------------------------------------

function readState(bytes commitment) returns (
    bytes20, bytes20, bytes20, int, int, int, int, int, int, bytes32
) {
    require(commitment.length == COMMITMENT_SIZE, "state: bad commitment size");
    bytes20 supporterPkh = unsafe_bytes20(commitment.slice(0, 20));
    bytes20 supporteePkh = unsafe_bytes20(commitment.slice(20, 40));
    bytes20 servicePkh = unsafe_bytes20(commitment.slice(40, 60));
    int amount = int(commitment.slice(60, 68));
    int amountNext = int(commitment.slice(68, 76));
    int period = int(commitment.slice(76, 80));
    int periodNext = int(commitment.slice(80, 84));
    int lastPeriodTime = int(commitment.slice(84, 88));
    int mode = int(commitment.slice(88, 89));
    bytes32 fundsCategory = unsafe_bytes32(commitment.slice(89, 121));
    require(amount > 0, "state: amount must be positive");
    require(amountNext > 0, "state: amountNext must be positive");
    require(period > 0, "state: period must be positive");
    require(periodNext > 0, "state: periodNext must be positive");
    require(mode == 0 || mode == 1, "state: invalid mode");
    return supporterPkh, supporteePkh, servicePkh, amount, amountNext, period,
        periodNext, lastPeriodTime, mode, fundsCategory;
}

function writeState(
    bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
    int amount, int amountNext, int period, int periodNext,
    int lastPeriodTime, int mode, bytes32 fundsCategory
) returns (bytes) {
    bytes commitment = supporterPkh + supporteePkh + servicePkh
        + toPaddedBytes(amount, 8) + toPaddedBytes(amountNext, 8)
        + toPaddedBytes(period, 4) + toPaddedBytes(periodNext, 4)
        + toPaddedBytes(lastPeriodTime, 4) + toPaddedBytes(mode, 1)
        + fundsCategory;
    require(commitment.length == COMMITMENT_SIZE, "state: bad commitment size");
    return commitment;
}

// -----------------------------------------------------------------------------
// Actor presence — authorisation without signatures
// -----------------------------------------------------------------------------

function isPresent(bytes20 pkh) returns (bool) {
    bool present = false;
    for (int i = 0; i < tx.inputs.length; i++) {
        if (tx.inputs[i].lockingBytecode == new LockingBytecodeP2PKH(pkh)) {
            present = true;
        }
        if (tx.inputs[i].lockingBytecode == new LockingBytecodeP2SH20(pkh)) {
            present = true;
        }
    }
    return present;
}

// -----------------------------------------------------------------------------
// Covenant accounting
// -----------------------------------------------------------------------------

// Index of the single input carrying the mutable state NFT — and it must itself
// be locked by this covenant. That combination is what stops a decoy state UTXO
// (a rogue NFT holding a forged commitment, minted by whoever owns the state
// category's minting NFT) from being used to drain a live covenant.
function stateInputIndex(bytes32 stateCategory, bytes contractLock) returns (int) {
    int found = -1;
    int count = 0;
    for (int i = 0; i < tx.inputs.length; i++) {
        if (tx.inputs[i].tokenCategory == stateCategory + MUTABLE_NFT) {
            require(tx.inputs[i].lockingBytecode == contractLock, "state: input not owned by the covenant");
            found = i;
            count = count + 1;
        }
    }
    require(count == 1, "state: expected exactly one state input");
    return found;
}

// The escrow is the funds-category input CO-CREATED with the state NFT: it shares
// the state input's `outpointTransactionHash`. A stray funds UTXO (different txid)
// can never satisfy this, so it can never pose as escrow. It must ALSO be locked by
// this covenant (mirroring `stateInputIndex`): a co-created escrow locked to a
// different script would otherwise produce an unusable sub whose funds the covenant
// can never spend. Every function requires the escrow as an input — a function that
// recreates or burns the covenant without spending the escrow would silently demote
// it to a stray.
function escrowInputIndex(int stateIdx, bytes32 fundsCategory, bytes contractLock) returns (int) {
    int found = -1;
    int count = 0;
    for (int i = 0; i < tx.inputs.length; i++) {
        if (tx.inputs[i].tokenCategory == fundsCategory) {
            if (tx.inputs[i].outpointTransactionHash == tx.inputs[stateIdx].outpointTransactionHash) {
                require(tx.inputs[i].lockingBytecode == contractLock, "escrow: input not owned by the covenant");
                found = i;
                count = count + 1;
            }
        }
    }
    require(count == 1, "escrow: missing co-created escrow input");
    return found;
}

// Total fungible balance of `category` brought into the transaction: the
// covenant's own funds UTXO plus anything a party contributes in the same
// transaction. Used to (a) absorb strays (`fund`), (b) sweep strays into a
// refund/payout (`cancel`/`withdraw`), (c) count the new asset in (`migrate`)
// and (d) preserve the full balance (`modify`/`setPkh`). NEVER used as the
// settlement balance — that is the escrow alone.
function totalIn(bytes32 category) returns (int) {
    int total = 0;
    for (int i = 0; i < tx.inputs.length; i++) {
        if (tx.inputs[i].tokenCategory == category) {
            total = total + tx.inputs[i].tokenAmount;
        }
    }
    return total;
}

// True when a raw `tokenCategory` introspection value names `category` under any
// NFT capability (none / mutable / minting).
function isCategoryOf(bytes32 category, bytes tokenCategory) returns (bool) {
    return tokenCategory == category
        || tokenCategory == category + 0x01
        || tokenCategory == category + 0x02;
}

// -----------------------------------------------------------------------------
// Service fee (design.md § Architecture Decisions — service fee)
//
//   perPeriodFee(x) = max(x · SERVICE_FEE_PERCENT / 100, MIN_FEE_PER_PERIOD)
//
// A split INSIDE the payout: the pre-settle entitlement (`owedPreSettle =
// amount · (n + mode)`) is untouched, so an off-by-one in the fee can misprice a
// payment but cannot strand earned funds.
// -----------------------------------------------------------------------------

function perPeriodFee(int x) returns (int) {
    int percentage = x * SERVICE_FEE_PERCENT / 100;
    return max(percentage, MIN_FEE_PER_PERIOD);
}

// -----------------------------------------------------------------------------
// Shared settlement core (design.md § Functions — gate → settle → delta)
//
//   n = truncate((tx.locktime − lastPeriodTime) / period)   elapsed periods
//   m = min(n, floor(spendable / amount))                   periods the escrow covers
//   gross = m · amount                                      paid to the supportee
//   fee   = m · perPeriodFee(amount)                        routed to servicePkh
//   lastPeriodTime += m · period                            advance by periods PAID
//   amount = amountNext, period = periodNext                always-replace terms
//
// `settle()` NEVER forgives arrears — advancing by `m` (never by `n`) leaves
// n' = n − m visible to everyone. It never recreates the covenant, burns the
// NFT, refunds or swaps assets; those are each caller's delta.
//
// With m = 0 the settlement is a no-op: nothing is paid and the clock does not
// move, so an underfunded subscription can never advance its own clock.
// -----------------------------------------------------------------------------

function settle(
    bytes20 supporteePkh, bytes20 servicePkh, int amount, int amountNext,
    int period, int periodNext, int lastPeriodTime, int spendable,
    bytes32 fundsCategory
) returns (int, int, int, int, int, int) {
    require(tx.locktime >= lastPeriodTime, "settle: locktime is before the anchor");
    int n = (tx.locktime - lastPeriodTime) / period;
    int m = min(n, spendable / amount);
    int gross = m * amount;
    int fee = m * perPeriodFee(amount);
    if (gross > 0) {
        require(tx.outputs[0].lockingBytecode == new LockingBytecodeP2PKH(supporteePkh), "settle: supportee payment destination");
        require(tx.outputs[0].tokenCategory == fundsCategory, "settle: supportee payment category");
        require(tx.outputs[0].tokenAmount == gross - fee, "settle: supportee payment amount");
        require(tx.outputs[1].lockingBytecode == new LockingBytecodeP2PKH(servicePkh), "settle: service payment destination");
        require(tx.outputs[1].tokenCategory == fundsCategory, "settle: service payment category");
        require(tx.outputs[1].tokenAmount == fee, "settle: service payment amount");
    }
    return lastPeriodTime + m * period, amountNext, periodNext, gross, n, m;
}

// -----------------------------------------------------------------------------
// Output constraints
// -----------------------------------------------------------------------------

function stateOk(int idx, bytes contractLock, bytes32 stateCategory, bytes commitment) returns (bool) {
    require(tx.outputs[idx].lockingBytecode == contractLock, "state out: wrong lock");
    require(tx.outputs[idx].tokenCategory == stateCategory + MUTABLE_NFT, "state out: wrong category");
    require(tx.outputs[idx].tokenAmount == 0, "state out: must not carry fungibles");
    require(tx.outputs[idx].nftCommitment == commitment, "state out: wrong commitment");
    return true;
}

function fundsOk(int idx, bytes contractLock, bytes32 fundsCategory, int amount) returns (bool) {
    require(tx.outputs[idx].lockingBytecode == contractLock, "funds out: wrong lock");
    require(tx.outputs[idx].tokenCategory == fundsCategory, "funds out: wrong category");
    require(tx.outputs[idx].tokenAmount == amount, "funds out: wrong amount");
    return true;
}

function paymentOk(int idx, bytes20 pkh, bytes32 fundsCategory, int amount) returns (bool) {
    require(tx.outputs[idx].lockingBytecode == new LockingBytecodeP2PKH(pkh), "payment: wrong destination");
    require(tx.outputs[idx].tokenCategory == fundsCategory, "payment: wrong category");
    require(tx.outputs[idx].tokenAmount == amount, "payment: wrong amount");
    return true;
}

// Foreign-token cleanup (design.md § Security Notes — stranded funds and foreign
// tokens). Outputs past the ones the contract mandates may exist (a BCH change
// output, typically), but they must not carry the state or funds category. A
// token of any OTHER category is allowed only when routed to `supporterPkh`, so a
// mis-sent token can be cleared instead of dying with the NFT. The state-category
// check is evaluated FIRST so the state NFT can never be routed out.
function tailOk(int fromIndex, bytes32 fundsCategory, bytes32 stateCategory, bytes20 supporterPkh) returns (bool) {
    for (int i = fromIndex; i < tx.outputs.length; i++) {
        bytes cat = tx.outputs[i].tokenCategory;
        if (cat != 0x) {
            require(!isCategoryOf(stateCategory, cat), "tail: state category must not be routed out");
            require(!isCategoryOf(fundsCategory, cat), "tail: funds category must not be in the tail");
            require(tx.outputs[i].lockingBytecode == new LockingBytecodeP2PKH(supporterPkh), "tail: foreign token must go to the supporter");
        }
    }
    return true;
}

// =============================================================================
// Subscription state machine — every function is `gate → settle → delta`
// =============================================================================

contract TokenSubscription(bytes32 stateCategory) {

    // -------------------------------------------------------------------------
    // pull — permissionless, m-period catch-up, recreates the covenant
    // -------------------------------------------------------------------------
    function pull() {
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int amountNext, int period, int periodNext,
            int lastPeriodTime, int mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "pull: categories must differ");
        int escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        require(tx.time >= lastPeriodTime + period, "pull: period has not elapsed yet");

        int escrow = tx.inputs[escrowIdx].tokenAmount;
        int spendable = escrow - SEED;
        int newLastPeriodTime = lastPeriodTime;
        int newAmount = amount;
        int newPeriod = period;
        int gross = 0;
        (
            newLastPeriodTime, newAmount, newPeriod, gross, int unused n, int unused m
        ) = settle(supporteePkh, servicePkh, amount, amountNext, period, periodNext, lastPeriodTime, spendable, fundsCat);
        // Gate from `settle()`: a settlement that pays nothing must not happen —
        // an underfunded subscription can never advance its clock.
        require(gross > 0, "pull: balance does not cover a period");

        // The seed is retained, so `escrow − gross ≥ SEED ≥ 1` always: the funds
        // output is always recreated (no empty-escrow layout branch).
        require(fundsOk(3, contractLock, fundsCat, escrow - gross), "pull: bad funds output");
        require(stateOk(2, contractLock, stateCategory, writeState(
            supporterPkh, supporteePkh, servicePkh, newAmount, amountNext,
            newPeriod, periodNext, newLastPeriodTime, mode, fundsCat
        )), "pull: bad state output");
        require(tailOk(4, fundsCat, stateCategory, supporterPkh), "pull: extra outputs");
    }

    // -------------------------------------------------------------------------
    // cancel — boundary-gated; settle, refund the remainder, burn the state NFT
    // -------------------------------------------------------------------------
    function cancel() {
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int amountNext, int period, int periodNext,
            int lastPeriodTime, int unused mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "cancel: categories must differ");
        int escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        require(tx.time >= lastPeriodTime + period, "cancel: boundary not reached");
        require(
            isPresent(supporterPkh) || isPresent(supporteePkh) || isPresent(servicePkh),
            "cancel: unauthorised"
        );

        int escrow = tx.inputs[escrowIdx].tokenAmount;
        int spendable = escrow - SEED;
        int gross = 0;
        (
            int unused settledAnchor, int unused promotedAmount, int unused promotedPeriod,
            gross, int unused n, int unused m
        ) = settle(supporteePkh, servicePkh, amount, amountNext, period, periodNext, lastPeriodTime, spendable, fundsCat);

        // Refund is everything remaining after the settlement (seed + strays):
        // `totalIn` folds the escrow remainder and any stray funds UTXO together.
        int total = totalIn(fundsCat);
        int refund = total - gross;

        int idx = 0;
        if (gross > 0) {
            idx = 2;
        }
        require(paymentOk(idx, supporterPkh, fundsCat, refund), "cancel: bad refund output");
        idx = idx + 1;
        require(tailOk(idx, fundsCat, stateCategory, supporterPkh), "cancel: extra outputs");
        // The state NFT must be burned: no output may carry the state category
        // under any capability — a mutable NFT can legally be *downgraded* to an
        // immutable one, which would otherwise keep a frozen covenant alive.
        for (int i = 0; i < tx.outputs.length; i++) {
            require(!isCategoryOf(stateCategory, tx.outputs[i].tokenCategory), "cancel: state NFT must be burned");
        }
    }

    // -------------------------------------------------------------------------
    // modify — mutual consent, always-replace; no settlement, clock untouched
    // -------------------------------------------------------------------------
    function modify(int newAmountNext, int newPeriodNext) {
        require(newAmountNext > 0, "modify: amountNext must be positive");
        require(newPeriodNext > 0, "modify: periodNext must be positive");
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int unused amountNext, int period, int unused periodNext,
            int lastPeriodTime, int mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "modify: categories must differ");
        int unused escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        require(
            isPresent(supporterPkh) && isPresent(supporteePkh),
            "modify: supporter and supportee must both be present"
        );

        int balance = totalIn(fundsCat);
        require(stateOk(0, contractLock, stateCategory, writeState(
            supporterPkh, supporteePkh, servicePkh, amount, newAmountNext,
            period, newPeriodNext, lastPeriodTime, mode, fundsCat
        )), "modify: bad state output");
        require(fundsOk(1, contractLock, fundsCat, balance), "modify: bad funds output");
        require(tailOk(2, fundsCat, stateCategory, supporterPkh), "modify: extra outputs");
    }

    // -------------------------------------------------------------------------
    // setPkh — 1-signature self-service role transfer; exactly one role per call
    // -------------------------------------------------------------------------
    function setPkh(bytes20 newSupporterPkh, bytes20 newSupporteePkh, bytes20 newServicePkh) {
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int amountNext, int period, int periodNext,
            int lastPeriodTime, int mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "setPkh: categories must differ");
        int unused escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        // Exactly one role moves, authorised solely by its current holder. The
        // two untouched hashes are carried through as-is, so a cross-role edit
        // can never produce a valid transaction.
        int changed = 0;
        if (newSupporterPkh != supporterPkh) {
            require(isPresent(supporterPkh), "setPkh: supporter presence required");
            changed = changed + 1;
        }
        if (newSupporteePkh != supporteePkh) {
            require(isPresent(supporteePkh), "setPkh: supportee presence required");
            changed = changed + 1;
        }
        if (newServicePkh != servicePkh) {
            require(isPresent(servicePkh), "setPkh: service presence required");
            changed = changed + 1;
        }
        require(changed == 1, "setPkh: exactly one role may change");

        int balance = totalIn(fundsCat);
        require(stateOk(0, contractLock, stateCategory, writeState(
            newSupporterPkh, newSupporteePkh, newServicePkh, amount, amountNext,
            period, periodNext, lastPeriodTime, mode, fundsCat
        )), "setPkh: bad state output");
        require(fundsOk(1, contractLock, fundsCat, balance), "setPkh: bad funds output");
        require(tailOk(2, fundsCat, stateCategory, supporterPkh), "setPkh: extra outputs");
    }

    // -------------------------------------------------------------------------
    // fund — permissionless top-up; state untouched, clock untouched
    // -------------------------------------------------------------------------
    function fund() {
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int amountNext, int period, int periodNext,
            int lastPeriodTime, int mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "fund: categories must differ");
        int unused escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        // `totalIn` covers the covenant's existing escrow _and_ whatever the
        // funder contributes — strays included — the whole lot is locked back in.
        int total = totalIn(fundsCat);
        require(total > 0, "fund: nothing to fund");
        require(stateOk(0, contractLock, stateCategory, writeState(
            supporterPkh, supporteePkh, servicePkh, amount, amountNext,
            period, periodNext, lastPeriodTime, mode, fundsCat
        )), "fund: bad state output");
        require(fundsOk(1, contractLock, fundsCat, total), "fund: bad funds output");
        require(tailOk(2, fundsCat, stateCategory, supporterPkh), "fund: extra outputs");
    }

    // -------------------------------------------------------------------------
    // withdraw — settle, then reclaim `spendable − owedPreSettle` (earned stays)
    // -------------------------------------------------------------------------
    function withdraw() {
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int amountNext, int period, int periodNext,
            int lastPeriodTime, int mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "withdraw: categories must differ");
        int escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        require(isPresent(supporterPkh), "withdraw: supporter presence required");

        int escrow = tx.inputs[escrowIdx].tokenAmount;
        int spendable = escrow - SEED;
        int newLastPeriodTime = lastPeriodTime;
        int newAmount = amount;
        int newPeriod = period;
        int gross = 0;
        int n = 0;
        (
            newLastPeriodTime, newAmount, newPeriod, gross, n, int unused m
        ) = settle(supporteePkh, servicePkh, amount, amountNext, period, periodNext, lastPeriodTime, spendable, fundsCat);

        // owedPreSettle = amount · (n + mode): every period the supportee has
        // earned so far, plus — in mode B — the escrowed upcoming period. This is
        // the PRE-settle entitlement (the full `n`); settle pays `m` of those
        // periods, so what stays locked is `owedPreSettle − gross`. (Do not
        // confuse it with `migrate`'s `carryOver`, the POST-settle floor.)
        int owedPreSettle = amount * (n + mode);
        require(spendable >= owedPreSettle, "withdraw: balance is below the reserved amount");

        // The supporter may take `spendable − owedPreSettle`; the covenant retains
        // `(owedPreSettle − gross) + SEED` — the supportee's remaining entitlement
        // plus the seed, so the escrow UTXO always survives.
        int retained = (owedPreSettle - gross) + SEED;
        int payout = (escrow - gross) - retained;
        // Strays are swept into the supporter's payout.
        int strays = totalIn(fundsCat) - escrow;
        int supporterOut = payout + strays;

        int idx = 2;
        if (gross > 0) {
            idx = 4;
        }
        require(stateOk(idx - 2, contractLock, stateCategory, writeState(
            supporterPkh, supporteePkh, servicePkh, newAmount, amountNext,
            newPeriod, periodNext, newLastPeriodTime, mode, fundsCat
        )), "withdraw: bad state output");
        require(fundsOk(idx - 1, contractLock, fundsCat, retained), "withdraw: bad funds output");
        require(paymentOk(idx, supporterPkh, fundsCat, supporterOut), "withdraw: bad payout output");
        idx = idx + 1;
        require(tailOk(idx, fundsCat, stateCategory, supporterPkh), "withdraw: extra outputs");
    }

    // -------------------------------------------------------------------------
    // reactivate — only while in arrears: pay the whole escrow except the seed,
    // waive the rest, promote terms, stay on the grid. This is the ONLY function
    // in the contract that ever forgives arrears, and it does NOT call `settle()`.
    // -------------------------------------------------------------------------
    function reactivate() {
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int amountNext, int period, int periodNext,
            int lastPeriodTime, int mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "reactivate: categories must differ");
        int escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        require(isPresent(supporterPkh), "reactivate: supporter presence required");
        require(tx.locktime >= lastPeriodTime, "reactivate: locktime is before the anchor");

        int escrow = tx.inputs[escrowIdx].tokenAmount;
        int total = totalIn(fundsCat);
        int newFunds = total - escrow;

        // Arrears gate, evaluated BEFORE any payment: paused ⟺ escrow < payable.
        // The fresh period is the *upcoming* period, so it is gated at the
        // upcoming rate (`amountNext`), not the rate of the periods just ended.
        int n = (tx.locktime - lastPeriodTime) / period;
        int payable = amount * n;
        require(escrow < payable, "reactivate: rejected while funded");
        require(newFunds >= amountNext, "reactivate: at least one fresh period must be funded");

        // Pay the whole escrow except the seed (gross); the service fee is carved
        // out of it, per period paid, each at the rate in force when it was paid.
        // Mode B's fresh period is escrowed and pays its fee at the boundary
        // `pull`, never here, so it adds nothing to the fee now.
        int spendable = escrow - SEED;
        int m = spendable / amount;
        int fee = m * perPeriodFee(amount);
        int prepaid = 0;
        int contractBalance = SEED + newFunds;
        if (mode == 0) {
            fee = fee + perPeriodFee(amountNext);
            prepaid = amountNext;
            contractBalance = SEED + newFunds - amountNext;
        }
        int supporteeAmount = spendable + prepaid - fee;

        // Advance on the grid (waives the unpaid remainder, no drift) and promote
        // terms so the fresh period is priced at the new rate.
        int newAnchor = lastPeriodTime + n * period;
        int newAmount = amountNext;
        int newPeriod = periodNext;

        int idx = 0;
        if (supporteeAmount > 0) {
            require(paymentOk(0, supporteePkh, fundsCat, supporteeAmount), "reactivate: bad supportee output");
            idx = 1;
        }
        if (fee > 0) {
            require(paymentOk(idx, servicePkh, fundsCat, fee), "reactivate: bad service output");
            idx = idx + 1;
        }
        require(stateOk(idx, contractLock, stateCategory, writeState(
            supporterPkh, supporteePkh, servicePkh, newAmount, amountNext,
            newPeriod, periodNext, newAnchor, mode, fundsCat
        )), "reactivate: bad state output");
        idx = idx + 1;
        require(fundsOk(idx, contractLock, fundsCat, contractBalance), "reactivate: bad funds output");
        idx = idx + 1;
        require(tailOk(idx, fundsCat, stateCategory, supporterPkh), "reactivate: extra outputs");
    }

    // -------------------------------------------------------------------------
    // migrate — mutual consent; settle, then swap only the unearned remainder
    // -------------------------------------------------------------------------
    function migrate(bytes32 newFundsCategory, int newAmount, int newAmountNext) {
        require(newAmount > 0, "migrate: amount must be positive");
        require(newAmountNext > 0, "migrate: amountNext must be positive");
        require(newFundsCategory != stateCategory, "migrate: new category is the state category");
        bytes contractLock = tx.inputs[this.activeInputIndex].lockingBytecode;
        int stateIdx = stateInputIndex(stateCategory, contractLock);
        (
            bytes20 supporterPkh, bytes20 supporteePkh, bytes20 servicePkh,
            int amount, int amountNext, int period, int periodNext,
            int lastPeriodTime, int mode, bytes32 fundsCat
        ) = readState(tx.inputs[stateIdx].nftCommitment);
        require(fundsCat != stateCategory, "migrate: old categories must differ");
        require(newFundsCategory != fundsCat, "migrate: nothing to migrate");
        int escrowIdx = escrowInputIndex(stateIdx, fundsCat, contractLock);

        require(
            isPresent(supporterPkh) && isPresent(supporteePkh),
            "migrate: supporter and supportee must both be present"
        );

        int escrow = tx.inputs[escrowIdx].tokenAmount;
        int spendable = escrow - SEED;
        int gross = 0;
        int n = 0;
        int m = 0;
        int settledAnchor = 0;
        (
            settledAnchor, int unused promotedAmount, int unused promotedPeriod,
            gross, n, m
        ) = settle(supporteePkh, servicePkh, amount, amountNext, period, periodNext, lastPeriodTime, spendable, fundsCat);

        // The new escrow must cover what the supportee is still owed under the
        // new denomination: the arrears that survive the settle (`n − m` periods)
        // plus, in mode B, the escrowed upcoming period — AND the seed, so the
        // recreated state NFT always has a co-created escrow (a 0-unit token
        // output is not a token UTXO, so without the seed the sub would be
        // bricked). The contract cannot verify an exchange rate (there is no
        // oracle), so this bound is the only fairness the chain can enforce; the
        // supportee's consent — plus the presence checks above — is the actual
        // safeguard (design.md Security).
        //
        // `carryOver` is the POST-settle floor (the surviving `n − m`), which is a
        // different quantity from `withdraw`'s pre-settle `owedPreSettle`
        // (`amount · (n + mode)`). They collapse to the same retained balance —
        // `owedPreSettle − gross == amount · (n − m + mode)` — because settle has
        // already paid the `m` periods; only the denomination differs here.
        int carryOver = newAmount * ((n - m) + mode);
        int newEscrow = totalIn(newFundsCategory);
        require(newEscrow >= carryOver + SEED, "migrate: new escrow below the reserved amount");

        // The unearned remainder of the old asset goes back to the supporter,
        // computed from the old-asset balance left after the settle.
        int oldRemainder = totalIn(fundsCat) - gross;

        int idx = 0;
        if (gross > 0) {
            idx = 2;
        }
        require(stateOk(idx, contractLock, stateCategory, writeState(
            supporterPkh, supporteePkh, servicePkh, newAmount, newAmountNext,
            period, periodNext, settledAnchor, mode, newFundsCategory
        )), "migrate: bad state output");
        idx = idx + 1;
        // The funds output is ALWAYS recreated (newEscrow ≥ SEED ≥ 1), so the
        // co-creation invariant holds after the swap.
        require(fundsOk(idx, contractLock, newFundsCategory, newEscrow), "migrate: bad funds output");
        idx = idx + 1;
        if (oldRemainder > 0) {
            require(paymentOk(idx, supporterPkh, fundsCat, oldRemainder), "migrate: bad old-asset output");
            idx = idx + 1;
        }
        require(tailOk(idx, fundsCat, stateCategory, supporterPkh), "migrate: extra outputs");
    }
}
