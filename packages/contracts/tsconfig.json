{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "jest"
    ],
    "noEmit": true,
    "moduleResolution": "bundler",
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "artifacts/**/*.ts",
    "scripts/**/*.mjs",
    ".probe.ts"
  ]
}
